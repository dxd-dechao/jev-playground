# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts.bak

# production
/build

# typescript
*.tsbuildinfo

# test output / evidence
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/screenshots/

# local env files — every one of them, including any variant added later. A
# TypeSafe API key belongs only in an untracked file on the machine using it.
.env
.env.*
# ...except the checked-in template, which holds variable names and placeholders
# and never a real value.
!.env.example

# macOS
.DS_Store

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# offline evaluation output (reports, predictions, prepared requests)
/evaluation-output/
