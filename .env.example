# TypeSafe Jev — server environment template.
#
# Copy this file to `.env.local` and fill in your own key:
#
#     cp .env.example .env.local
#
# `.env.local` is ignored by git. This file is the only env file that is
# committed, and it must never contain a real key. Placeholders only.
#
# No key is needed to run the playground: `npm run build`, `npm run dev`, all
# four checks, and browsing/editing work without one. A key is needed only to
# Evaluate with Jev, which makes one real, billed model call per explicit press.
#
# These variables are read on the server only. They are never sent to the
# browser, and the browser cannot override the model or the provider URL.

# Required for Evaluate. Without it, /api/config reports `configured: false`,
# the Evaluate with Jev button stays disabled, and /api/evaluate answers 503.
TYPESAFE_API_KEY=replace-with-your-typesafe-api-key

# Optional. The model the server asks for. Defaults to `jev-latest`.
# (The SDK independently reads TYPESAFE_DEFAULT_MODEL; it is honoured as a
# fallback if TYPESAFE_MODEL is unset.)
# TYPESAFE_MODEL=jev-latest

# Optional shared password that gates Evaluate. Unset or blank = gate off
# (local default). Both sides are trimmed once so copy-paste still matches.
# This is not user accounts: anyone with the password can spend TypeSafe credits.
# PLAYGROUND_PASSWORD=replace-with-a-shared-playground-password

# HMAC key for the HttpOnly `jev_access` cookie. Required when
# PLAYGROUND_PASSWORD is set. Do not derive it from the password. Generate a
# long random value (for example `openssl rand -hex 32`).
# PLAYGROUND_SESSION_SECRET=replace-with-a-long-random-secret
